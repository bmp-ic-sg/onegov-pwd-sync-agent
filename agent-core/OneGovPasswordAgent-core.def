; =============================================================================
;  ONEGOV PASSWORD AGENT CORE — MODULE DEFINITION
;  Windows Password Watcher (OneGovPasswordAgent-core.dll)
;
;  Purpose:
;    Export the LSA Notification Package entry points so LSASS can invoke them.
;
;  Notes:
;    - Export names must match the implementations in your C code.
;    - Ordinals are optional on x64 but kept for compatibility.
; =============================================================================

LIBRARY OneGovPasswordAgent-core

EXPORTS
    InitializeChangeNotify @1
    PasswordChangeNotify   @2
