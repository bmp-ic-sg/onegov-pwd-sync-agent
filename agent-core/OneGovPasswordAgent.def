; =============================================================================
;  ONEGOV PASSWORD AGENT - MODULE DEFINITION FILE
;
;  Purpose:
;    Defines the exported entry points for the OneGovPasswordAgent.dll
;    (Windows Password Filter) so that LSASS can properly invoke them.
;
;  Notes:
;    - These exports must exactly match the signatures implemented in
;      OneGovPasswordAgent.c
;    - Entry point ordinals are required for compatibility with LSASS
; =============================================================================

LIBRARY OneGovPasswordAgent

EXPORTS
    InitializeChangeNotify @1
    PasswordChangeNotify   @2
