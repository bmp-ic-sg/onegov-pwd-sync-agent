<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     ONEGOV PASSWORD SYNC AGENT – HOST CONFIGURATION DIALOG (WiX v4)
     
     Purpose:
       Defines the custom UI dialog where administrators enter connection details
       for linking a Directory Server to the OneGov IDM Application Server.

     Features:
       • Collects SERVER, HOSTNAME, IPADDRESS, SECRETKEY properties
       • Performs client-side field validation before continuing
       • Provides simple “missing input” error dialog
       • Pre-wired navigation with InstallDirDlg and VerifyReadyDlg
       • Prepared hooks for future REST validation via ValidateAgent.dll
     ============================================================================= -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
    <!-- ============================================================
         BINARY RESOURCE (used by Info icons or other UI images)
         ============================================================ -->
    <Binary Id="InfoBmp" SourceFile="asset\info_16_16colors.bmp" />

    <UI Id="HostConfigurationUI">
      <UIRef Id="WixUI_Common"/>

      <!-- ============================================================
           MAIN DIALOG : HostConfigurationDlg
           Collects all OneGov + Directory connection parameters
           ============================================================ -->
      <Dialog Id="HostConfigurationDlg"
              Width="370" Height="270"
              Title="[ProductName] Setup">

        <!-- ============================================================
             HEADER SECTION (banner & title)
             ============================================================ -->
        <Control Id="BannerBmp"  Type="Bitmap" X="0"   Y="0"  Width="370" Height="44"
                 TabSkip="yes" Text="WixUI_Bmp_Banner"/>
        <Control Id="BannerTitle" Type="Text" X="14" Y="6" Width="300" Height="16"
                 Transparent="yes" NoPrefix="yes"
                 Text="!(loc.UIHostConfigHeader)"/>
        <Control Id="BannerSub"   Type="Text" X="27" Y="24" Width="300" Height="14"
                 Transparent="yes" NoPrefix="yes"
                 Text="!(loc.UIHostConfigDescription)"/>
        <Control Id="BottomLine"  Type="Line" X="0" Y="223" Width="370" Height="0"/>

        <!-- ============================================================
             BODY SECTION : CONNECTION FIELDS
             ============================================================ -->

        <!-- OneGov Application Server URL -->
        <Control Id="ServerLbl" Type="Text"
                 X="15" Y="64" Width="100" Height="12"
                 Text="OneGov Server URL:" />
        <Control Id="ServerEdit" Type="Edit"
                 X="125" Y="62" Width="230" Height="18"
                 Property="SERVER"
                 ToolTip="Enter the URL of OneGov Application Server (e.g. https://onegov.azlabs.sg/idm)" />

        <!-- Agent Hostname -->
        <Control Id="HostLbl" Type="Text"
                 X="15" Y="94" Width="100" Height="12"
                 Text="Agent Hostname:" />
        <Control Id="HostEdit" Type="Edit"
                 X="125" Y="92" Width="230" Height="18"
                 Property="HOSTNAME"
                 ToolTip="Enter the hostname of directory server (e.g. dc01.domain.local)." />

        <!-- Agent IP Address -->
        <Control Id="IpLbl" Type="Text"
                 X="15" Y="124" Width="100" Height="12"
                 Text="Agent IP Address:" />
        <Control Id="IpEdit" Type="Edit"
                 X="125" Y="122" Width="230" Height="18"
                 Property="IPADDRESS"
                 ToolTip="Enter the IP address of directory server (e.g. 192.168.1.10)" />

        <!-- OneGov Secret Key (multiline input) -->
        <Control Id="SecretLbl" Type="Text"
                 X="15" Y="154" Width="100" Height="12"
                 Text="Secret Key:" />
        <Control Id="SecretEdit" Type="Edit"
                 X="125" Y="152" Width="230" Height="18"
                 Property="SECRETKEY"
                 ToolTip="Paste the secret key generated in OneGov IDM." />

        <!-- ============================================================
             FOOTER SECTION : NAVIGATION & VALIDATION
             ============================================================ -->

        <!-- Back Button -->
        <Control Id="Back" Type="PushButton"
                 X="180" Y="243" Width="56" Height="17"
                 Text="Back">
          <Publish Event="NewDialog" Value="InstallDirDlg" Condition="1"/>
        </Control>

        <!-- Next Button -->
        <Control Id="Next" Type="PushButton"
                 X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="Next">

          <!-- Validation: ensure required fields are present -->
          <Publish Event="NewDialog"   Value="VerifyReadyDlg"
                   Condition="HOSTNAME AND IPADDRESS AND SECRETKEY"/>
          <Publish Event="SpawnDialog" Value="ConfigErrorDlg"
                   Condition="NOT (HOSTNAME AND IPADDRESS AND SECRETKEY)"/>
        </Control>

        <!-- Cancel Button -->
        <Control Id="Cancel" Type="PushButton"
                 X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1"/>
        </Control>

      </Dialog>

      <!-- ============================================================
           VALIDATION ERROR DIALOG
           Shown when mandatory fields are missing
           ============================================================ -->
      <Dialog Id="ConfigErrorDlg" Width="260" Height="120" Title="Missing configuration">
        <Control Id="Txt" Type="Text" X="15" Y="20" Width="230" Height="40"
                 Text="Please fill OneGov Server URL, Agent Hostname, Agent IP Address, and Secret Key before continuing."/>
        <Control Id="OK" Type="PushButton" X="102" Y="80" Width="56" Height="17"
                 Default="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" Condition="1"/>
        </Control>
      </Dialog>

      <!-- ============================================================
           DIALOG NAVIGATION LINKS
           Defines flow between standard WiX dialogs
           ============================================================ -->
      <Publish Dialog="InstallDirDlg" Control="Next"
               Event="NewDialog" Value="VerifyReadyDlg"
               Condition="0" Order="9980"/>

      <Publish Dialog="InstallDirDlg" Control="Next"
               Event="NewDialog" Value="HostConfigurationDlg"
               Condition="1" Order="9999"/>

      <Publish Dialog="VerifyReadyDlg" Control="Back"
               Event="NewDialog" Value="HostConfigurationDlg"
               Condition="1" Order="1"/>

      <!-- ============================================================
           (OPTIONAL) FUTURE INTEGRATION : REST VALIDATION
           ============================================================
           Example setup to call ValidateAgent.dll for online verification.
           Uncomment once ValidateAgent.dll is included in build output.

           <Binary Id="RestCaDll" SourceFile="bin\ValidateAgent.dll"/>
           <CustomAction Id="ValidateAgent"
                         BinaryRef="RestCaDll"
                         DllEntry="ValidateAgent"
                         Execute="immediate"
                         Return="check"/>

           <Publish Event="DoAction" Value="ValidateAgent"
                    Condition="HOSTNAME AND IPADDRESS AND SECRETKEY"/>
           <Publish Event="NewDialog" Value="VerifyReadyDlg"
                    Condition="HOSTNAME AND IPADDRESS AND SECRETKEY AND REST_OK = 1"/>
           <Publish Event="SpawnDialog" Value="ConfigErrorDlg"
                    Condition="HOSTNAME AND IPADDRESS AND SECRETKEY AND REST_OK <> 1"/>
           ============================================================ -->
    </UI>
  </Fragment>
</Wix>
